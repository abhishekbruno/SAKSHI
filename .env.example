# SAKSHI — Environment Configuration Template
# Copy this file to .env to configure local development or production settings.

# ─── Environment ─────────────────────────────────────────────────────────────
ENVIRONMENT=development
PROJECT_NAME="SAKSHI Investigation Platform"

# ─── Database Configuration ──────────────────────────────────────────────────
# Default: Local SQLite (development and test suite execution)
DATABASE_URL="sqlite:///./sakshi_cases.db"

# Production: PostgreSQL with pgvector (recommended for production RAG)
# DATABASE_URL="postgresql+psycopg://sakshi_user:your_secure_password@localhost:5432/sakshi_cases"

# PostgreSQL Connection Pool Tuning
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=10
DB_POOL_PRE_PING=true
DB_ECHO=false

# ─── RAG & Vector Retrieval ──────────────────────────────────────────────────
# deterministic_mock is permitted for local dev/testing without downloading weights.
# Production uses sentence_transformer with local model weights.
EMBEDDING_PROVIDER=deterministic_mock
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384
RAG_SEARCH_DEFAULT_LIMIT=10
RAG_SEARCH_MAX_LIMIT=20
RAG_SEARCH_MAX_QUERY_CHARS=2000
RAG_SQLITE_RETRIEVAL_CANDIDATE_LIMIT=250

# ─── Authentication & Identity (MOD-02 & IAM) ────────────────────────────────
# AUTH_MODE: "development" (local only), "oidc", or "firebase" (production identity)
AUTH_MODE=development

# OIDC Provider Settings (required when AUTH_MODE=oidc)
# OIDC_ISSUER_URL="https://idp.police.gov.in/realms/sakshi"
# OIDC_AUDIENCE="sakshi-investigation-app"
# OIDC_CLIENT_ID="sakshi-api"
# OIDC_JWKS_URL="https://idp.police.gov.in/realms/sakshi/protocol/openid-connect/certs"

# Firebase Authentication (required when AUTH_MODE=firebase)
# FIREBASE_PROJECT_ID="sakshi-production"
# FIREBASE_WEB_API_KEY="AIzaSy..."

# ─── Antivirus Scanner (MOD-07) ──────────────────────────────────────────────
# ANTIVIRUS_SCANNER: "eicar_heuristic" (dev/cloud container) or "clamav" (production daemon)
ANTIVIRUS_SCANNER=eicar_heuristic
CLAMAV_HOST="127.0.0.1"
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30.0

# ─── CORS Configuration ──────────────────────────────────────────────────────
# JSON array of origins permitted to communicate with the API
CORS_ORIGINS='["http://localhost:8000", "http://127.0.0.1:8000"]'

